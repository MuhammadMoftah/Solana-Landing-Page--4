---
import { Picture } from 'astro:assets';
import Icon from '../ui/Icon.astro';
import media from '../../content/solana-east.media.js';
import { getSection, splitTail, pad2 } from '../../lib/content.js';

const { content } = getSection('hero');
const image = media.villaPool4;
const { lead, tail } = splitTail(content.heading, 2);
---

<section id="top" class="relative isolate overflow-hidden pt-[4.5rem]" aria-labelledby="hero-title">
  <div class="container-x relative grid items-center gap-x-10 gap-y-10 pt-10 pb-16 lg:min-h-[min(48rem,calc(100svh-4.5rem))] lg:grid-cols-12 lg:pt-14 lg:pb-20">
    <div class="animate-settle relative z-10 lg:col-span-5 xl:col-span-5">
      <p class="eyebrow">{content.eyebrow}</p>
      <h1 id="hero-title" class="display-1 mt-5 text-[clamp(3rem,1.2rem+5.8vw,6.25rem)]">
        {lead}{' '}
        <span class="t-accent">{tail}<span aria-hidden="true">.</span></span>
      </h1>
      <p class="lead mt-7 max-w-[30rem]">{content.description}</p>
      <div class="mt-9 flex flex-wrap items-center gap-3">
        <a href={content.primaryCta.target} class="btn btn-solid">
          {content.primaryCta.label}
          <Icon name="arrow-ne" class="btn-arrow" />
        </a>
        <a href={content.secondaryCta.target} class="btn btn-ember">
          {content.secondaryCta.label}
          <Icon name="arrow" class="btn-arrow" />
        </a>
      </div>
    </div>

    <div class="relative lg:col-span-7">
      <p
        class="ghost-word animate-drift pointer-events-none absolute top-1/2 left-0 z-0 -translate-y-[58%] text-[clamp(5.5rem,18vw,14rem)] max-lg:left-1/2 max-lg:-translate-x-1/2"
        aria-hidden="true"
      >
        Solana
      </p>
      <div class="relative z-10 ml-auto w-full max-w-[42rem] lg:w-[92%]">
        <div class="corner-frame relative aspect-[5/4] overflow-hidden border border-white/10 bg-ink-850 sm:aspect-[16/11]">
          <Picture
            src={image.src}
            alt={image.alt}
            formats={['avif', 'webp']}
            widths={[480, 640, 800, 1000, 1280, 1600]}
            sizes="(min-width: 64rem) 42rem, 92vw"
            quality={58}
            priority
            class="media-fill animate-unveil object-[42%_58%]"
            pictureAttributes={{ class: 'contents' }}
          />
          <div class="absolute inset-0 bg-gradient-to-r from-ink-900/50 via-transparent to-transparent" aria-hidden="true"></div>
          <div class="absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-ink-900/80 to-transparent" aria-hidden="true"></div>
          <p class="label absolute right-4 bottom-4 z-10 bg-ink-950/75 px-3 py-1.5 backdrop-blur-sm">Illustrative render</p>
          <span class="label absolute top-4 left-4 z-10 text-ember-400" aria-hidden="true">SE_01</span>
        </div>
      </div>
    </div>
  </div>

  <div class="rule-top relative border-t">
    <ul class="container-x grid divide-y divide-white/10 sm:grid-cols-3 sm:divide-x sm:divide-y-0">
      {
        content.highlights.map((item: string, index: number) => (
          <li class="flex items-start gap-4 py-5 sm:px-6 sm:first:pl-0 sm:last:pr-0">
            <span class="numeral text-[1.5rem]">{pad2(index)}</span>
            <span class="meta pt-1 text-ash-300">{item}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
